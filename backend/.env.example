# backend/.env.example
# Copy to backend/.env and fill in real values.
# This file is read by python-dotenv at app startup.

# Database connection string
DATABASE_URL=postgresql://etf_user:CHANGE_ME@localhost:5432/etf_db

# Flask secret key
SECRET_KEY=change-me-in-production

# Data fetching
FETCH_ENABLED=false
FETCH_SSE_DAYS=5
